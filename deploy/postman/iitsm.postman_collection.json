{
  "info": {
    "name": "I-ITSM Task 3: seeded API workflows",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    }
  ],
  "item": [
    {
      "name": "Setup \u2014 real seeded accounts",
      "item": [
        {
          "name": "Login asha.rao",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"asha.rao@iitsm.demo\", \"password\": \"Demo@1234\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "const d=pm.response.json();",
                  "pm.test('Real access and refresh tokens returned',()=>{pm.expect(d.accessToken).to.be.a('string');pm.expect(d.refreshToken).to.be.a('string');});",
                  "pm.collectionVariables.set('token_asha.rao',d.accessToken);",
                  "pm.collectionVariables.set('id_asha.rao',d.user.id);",
                  "const map=JSON.parse(pm.collectionVariables.get('tokensByUserId')||'{}');",
                  "map[d.user.id]=d.accessToken;pm.collectionVariables.set('tokensByUserId',JSON.stringify(map));"
                ]
              }
            }
          ]
        },
