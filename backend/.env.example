# Copy to .env and fill in. .env is git-ignored. Never commit real values.
SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:postgresql://localhost:5432/iitsm
DB_USER=iitsm
DB_PASSWORD=change-me

# At least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

CORS_ORIGIN=http://localhost:5173

# AI: the key of the chosen provider (a Gemini key from Google AI Studio by default; GEMINI_API_KEY also works).
# Leave empty to force the keyword fallback.
LLM_API_KEY=
# gemini (default), anthropic, or fake (offline scripted client for demos and smoke runs)
LLM_PROVIDER=gemini
# Optional: model (empty = gemini-3.5-flash-lite for gemini, claude-haiku-5-5 for anthropic)
LLM_MODEL=

# Google sign-in (M2b): OAuth client id from the Google Cloud console (same id the frontend button uses)
GOOGLE_CLIENT_ID=
# google (real) or fake (offline test tokens; the app refuses it outside dev/demo/test profiles)
GOOGLE_VERIFIER=google

MAIL_HOST=localhost
MAIL_PORT=1025
