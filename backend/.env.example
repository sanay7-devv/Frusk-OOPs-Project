 # Copy to .env and fill in. .env is git-ignored. Never commit real values.
SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:postgresql://localhost:5432/iitsm
DB_USER=iitsm
DB_PASSWORD=change-me

# At least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

CORS_ORIGIN=http://localhost:5173

# Leave empty to force the keyword fallback
LLM_API_KEY=

MAIL_HOST=localhost
MAIL_PORT=1025
