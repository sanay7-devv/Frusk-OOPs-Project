            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "increase(iitsm_escalations_exhausted_total[1h])",
          "legendFormat": "exhausted",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "increase(iitsm_triage_needed_total[1h])",
          "legendFormat": "triage needed",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
