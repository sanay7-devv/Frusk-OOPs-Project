# ========================================================
# Whitelist only frontend/, icons/, .gitignore, and README.md
# ========================================================

# Ignore everything in root by default
/*

# Whitelist repository documentation and configuration
!.gitignore
!README.md
!README.MD
!readme.md

# Whitelist allowed directories
!/frontend/
!/icons/

# Explicitly ignore design mockups and reference materials
/admin design/
/employee design/
/team lead/
/technician design/
/reference's of other sites/

# Documentation and project spec PDFs
/DESIGN_BRIEF.md
/*.pdf

# Dependencies, build output, and local environment files
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.*
frontend/*.log
.vitest-cache/
.vitest/
*.log

# OS metadata
.DS_Store
Thumbs.db
